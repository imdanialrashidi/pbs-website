---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
import Button from "../components/ui/Button.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import { pageLanguage } from "../lib/language";
import { base } from "../lib/url";

const language = pageLanguage(site);
const ui = language.t;
const backLabel = ui.notFound.back;
---

<BaseLayout
  site={site}
  title={`${ui.notFound.title} | ${site.brand.name}`}
  description={ui.notFound.body}
  noindex
>
  <section class="section" aria-labelledby="not-found-title">
    <div class="shell not-found">
      <Eyebrow text={ui.notFound.eyebrow} />
      <p class="not-found__code" aria-hidden="true">
        {language.number(404, { useGrouping: false })}
      </p>
      <div class="not-found__body">
        <h1 id="not-found-title" class="display display--md">
          {ui.notFound.title}
        </h1>
        <p class="lede not-found__lede">{ui.notFound.body}</p>
      </div>
      <div>
        <Button href={base} label={backLabel} variant="primary" />
      </div>
    </div>
  </section>
</BaseLayout>
