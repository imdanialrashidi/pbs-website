---
import type { SiteConfig, WorkPageContent } from "../../config/types";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import HeadlineText from "../ui/Headline.astro";
import Icon from "../ui/Icon.astro";
import { pageLanguage } from "../../lib/language";
import { href, localeHref, localeHome } from "../../lib/url";

interface Props {
  site: SiteConfig;
  work: WorkPageContent;
}

const { site, work } = Astro.props;
const language = pageLanguage(site);
const home = localeHome(site);
const hasProjects = work.projects.length > 0;

const emptyAction = work.empty.action
  ? { ...work.empty.action, href: localeHref(site, work.empty.action.href) }
  : undefined;
const closingAction = work.closing.action
  ? { ...work.closing.action, href: localeHref(site, work.closing.action.href) }
  : undefined;
---

<div class="work-page">
  <nav class="work-breadcrumb" aria-label={work.breadcrumb.label}>
    <div class="shell work-breadcrumb__inner">
      <a href={home}>{work.breadcrumb.home}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{work.breadcrumb.current}</span>
    </div>
  </nav>

  <header class="work-hero">
    <div class="shell work-hero__grid">
      <div class="work-hero__copy">
        <Eyebrow text={work.eyebrow} />
        <h1 class="display display--lg work-hero__title">
          <HeadlineText headline={work.headline} />
        </h1>
        <p class="work-hero__intro">{work.intro}</p>
      </div>
      <div class="work-hero__mark" aria-hidden="true">
        <span class="work-hero__bars">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="work-hero__mark-label">PBS / WORK</span>
      </div>
    </div>
  </header>

  <div class="shell">
    {
      hasProjects ? (
        <section class="work-projects" aria-label={work.breadcrumb.current}>
          <ol class="work-projects__list">
            {work.projects.map((project, index) => (
              <li
                id={project.slug}
                class:list={["project", project.featured && "project--featured"]}
              >
                <div class="project__head">
                  <span class="project__index" aria-hidden="true">
                    {language.index(index + 1)}
                  </span>
                  <span class="project__meta">
                    {project.client ?? work.labels.project}
                    {project.year ? ` · ${project.year}` : ""}
                  </span>
                </div>

                {project.cover && (
                  <img
                    class="project__cover"
                    src={href(project.cover.src)}
                    alt={project.cover.alt}
                    width={project.cover.width}
                    height={project.cover.height}
                    loading="lazy"
                    decoding="async"
                  />
                )}

                <h2 class="project__title">{project.title}</h2>
                <p class="project__summary">{project.summary}</p>
                <p class="project__challenge">
                  <span>{work.labels.challenge}</span>
                  {project.challenge}
                </p>

                <dl class="project__facts">
                  <div>
                    <dt>{work.labels.scope}</dt>
                    <dd>{project.scope.join(" · ")}</dd>
                  </div>
                  <div>
                    <dt>{work.labels.outcome}</dt>
                    <dd>{project.outcome}</dd>
                  </div>
                </dl>

                {project.href && (
                  <a
                    class="project__visit"
                    href={href(project.href)}
                    target={project.href.startsWith("http") ? "_blank" : undefined}
                    rel={project.href.startsWith("http") ? "noopener noreferrer" : undefined}
                  >
                    {work.labels.visit}
                    <Icon name="arrow-up-right" size={15} />
                  </a>
                )}
              </li>
            ))}
          </ol>
        </section>
      ) : (
        <section class="work-empty" aria-labelledby="work-empty-title">
          <div class="work-empty__visual" aria-hidden="true">
            <div class="work-empty__file">
              <span class="work-empty__file-kicker">PBS / WORK</span>
              <span class="work-empty__file-mark"></span>
              <span class="work-empty__file-line"></span>
              <span class="work-empty__file-line"></span>
              <span class="work-empty__file-line work-empty__file-line--short"></span>
            </div>
          </div>

          <div class="work-empty__copy">
            <span class="work-empty__status">{work.empty.label}</span>
            <h2 id="work-empty-title" class="display display--md">{work.empty.title}</h2>
            <p class="work-empty__body">{work.empty.body}</p>
            {emptyAction && <Button {...emptyAction} class="work-empty__action" />}
          </div>
        </section>
      )
    }
  </div>

  <section class="section section--tint work-standard" aria-labelledby="work-standard-title">
    <div class="shell work-standard__grid">
      <div class="work-standard__head">
        <h2 id="work-standard-title" class="display display--md">{work.publishing.title}</h2>
        {work.publishing.intro && <p class="work-standard__intro">{work.publishing.intro}</p>}
      </div>

      <div class="work-standard__body">
        <ol class="work-standard__list">
          {work.publishing.items.map((item, index) => (
            <li>
              <span aria-hidden="true">{language.index(index + 1)}</span>
              <p>{item}</p>
            </li>
          ))}
        </ol>
        {work.publishing.note && <p class="work-standard__note">{work.publishing.note}</p>}
      </div>
    </div>
  </section>

  <section class="section work-closing" aria-labelledby="work-closing-title">
    <div class="shell work-closing__inner">
      <div>
        <h2 id="work-closing-title" class="display display--md">{work.closing.title}</h2>
        <p class="work-closing__body">{work.closing.body}</p>
      </div>
      {closingAction && <Button {...closingAction} />}
    </div>
  </section>
</div>

<style>
  .work-page {
    background: var(--c-canvas);
  }

  .work-breadcrumb {
    border-bottom: 1px solid var(--c-line);
  }

  .work-breadcrumb__inner {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    gap: 0.55rem;
    color: var(--c-muted);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .work-breadcrumb a {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
  }

  .work-breadcrumb a:hover {
    color: var(--c-action);
  }

  .work-breadcrumb [aria-current="page"] {
    color: var(--c-ink);
  }

  .work-hero {
    border-bottom: 1px solid var(--c-line);
    padding-block: clamp(2rem, 4.5vw, 4rem);
  }

  .work-hero__grid {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  .work-hero__copy {
    max-width: 48rem;
    min-width: 0;
  }

  .work-hero__title {
    max-width: 20ch;
  }

  :lang(fa) .work-hero__title {
    max-width: 22ch;
  }

  .work-hero__intro {
    max-width: 56ch;
    margin-top: 1.1rem;
    color: var(--c-muted);
    font-size: 1.02rem;
    line-height: 1.9;
  }

  .work-hero__mark {
    display: none;
    align-items: center;
    gap: 0.7rem;
    width: fit-content;
    border: 1px solid var(--c-line);
    border-radius: var(--shape-button);
    padding: 0.55rem 0.75rem;
    background: var(--c-tint);
  }

  .work-hero__bars {
    display: flex;
    height: 1.4rem;
    align-items: flex-end;
    gap: 3px;
  }

  .work-hero__bars span {
    display: block;
    width: 3px;
    border-radius: 1px;
    background: var(--c-accent);
  }

  .work-hero__bars span:nth-child(1) {
    height: 0.65rem;
  }

  .work-hero__bars span:nth-child(2) {
    height: 1rem;
  }

  .work-hero__bars span:nth-child(3) {
    height: 1.4rem;
  }

  .work-hero__mark-label {
    color: var(--c-muted);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.5;
  }

  .work-empty {
    display: grid;
    gap: 2rem;
    border-block: 1px solid var(--c-line);
    margin-block: clamp(2rem, 4vw, 3.25rem);
    padding-block: clamp(2rem, 4vw, 3.25rem);
  }

  .work-empty__visual {
    display: grid;
    min-height: 15rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: var(--shape-media);
    background: var(--c-tint);
  }

  .work-empty__file {
    display: grid;
    width: 9rem;
    min-height: 11.25rem;
    align-content: start;
    gap: 0.75rem;
    border: 1px solid var(--c-line);
    border-radius: 8px;
    padding: 1rem;
    background: var(--c-surface);
    box-shadow: 0 10px 24px rgb(16 24 40 / 6%);
    transform: rotate(-2deg);
  }

  .work-empty__file-kicker {
    color: var(--c-muted);
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
  }

  .work-empty__file-mark {
    display: block;
    width: 1.9rem;
    height: 2px;
    background: var(--c-accent);
  }

  .work-empty__file-line {
    display: block;
    height: 1px;
    background: var(--c-line);
  }

  .work-empty__file-line--short {
    width: 62%;
  }

  .work-empty__copy {
    min-width: 0;
  }

  .work-empty__status {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--c-action) 24%, var(--c-line));
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    color: var(--c-action);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .work-empty__copy h2 {
    margin-top: 0.75rem;
  }

  .work-empty__body {
    max-width: 54ch;
    margin-top: 0.75rem;
    color: var(--c-muted);
    font-size: 0.97rem;
    line-height: 1.9;
  }

  .work-empty__action {
    margin-top: 1.25rem;
  }

  .work-standard {
    border-block: 1px solid var(--c-line);
  }

  .work-standard__grid {
    display: grid;
    gap: 2rem;
  }

  .work-standard__head h2 {
    max-width: 18ch;
  }

  .work-standard__intro {
    max-width: 48ch;
    margin-top: 0.9rem;
    color: var(--c-muted);
    font-size: 0.96rem;
    line-height: 1.85;
  }

  .work-standard__list {
    border-top: 1px solid var(--c-line);
  }

  .work-standard__list li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.8rem;
    border-bottom: 1px solid var(--c-line);
    padding-block: 0.8rem;
  }

  .work-standard__list span {
    padding-top: 0.15rem;
    color: var(--c-action);
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.7;
  }

  .work-standard__list p {
    color: var(--c-ink);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .work-standard__note {
    max-width: 52ch;
    margin-top: 0.9rem;
    color: var(--c-muted);
    font-size: 0.84rem;
    line-height: 1.8;
  }

  .work-closing {
    border-top: 1px solid var(--c-line);
  }

  .work-closing__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .work-closing__body {
    max-width: 50ch;
    margin-top: 0.7rem;
    color: var(--c-muted);
    font-size: 0.96rem;
    line-height: 1.85;
  }

  .work-projects {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .work-projects__list {
    display: grid;
    gap: 2.5rem;
  }

  .project {
    min-width: 0;
    border-top: 1px solid var(--c-line);
    padding-top: 1rem;
  }

  .project__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .project__index {
    color: var(--c-action);
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .project__meta {
    color: var(--c-muted);
    font-size: 0.72rem;
    font-weight: 650;
    line-height: 1.5;
    text-align: end;
  }

  .project__cover {
    width: 100%;
    height: auto;
    margin-top: 1rem;
    border-radius: var(--shape-media);
    object-fit: cover;
  }

  .project__title {
    margin-top: 1.1rem;
    font-family: var(--type-display);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .project__summary {
    max-width: 55ch;
    margin-top: 0.55rem;
    color: var(--c-muted);
    font-size: 0.95rem;
    line-height: 1.85;
  }

  .project__challenge {
    max-width: 55ch;
    margin-top: 0.9rem;
    color: var(--c-ink);
    font-size: 0.92rem;
    line-height: 1.8;
  }

  .project__challenge span {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--c-muted);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .project__facts {
    display: grid;
    gap: 0.75rem;
    border-top: 1px solid var(--c-line);
    margin-top: 1rem;
    padding-top: 0.8rem;
  }

  .project__facts dt {
    color: var(--c-muted);
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .project__facts dd {
    margin-top: 0.15rem;
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .project__visit {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    color: var(--c-action);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .project__visit:hover {
    color: var(--c-ink);
  }

  :lang(fa) .work-hero__intro,
  :lang(fa) .work-empty__body,
  :lang(fa) .work-standard__intro,
  :lang(fa) .work-standard__list p,
  :lang(fa) .work-closing__body,
  :lang(fa) .project__summary,
  :lang(fa) .project__challenge {
    line-height: 1.95;
  }

  :lang(fa) .project__title {
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.6;
  }

  :lang(fa) .project__challenge span {
    font-size: 0.72rem;
    letter-spacing: 0;
    text-transform: none;
  }

  @media (min-width: 760px) {
    .work-empty {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: 3rem;
    }

    .work-empty__visual {
      min-height: 18rem;
    }
  }

  @media (min-width: 900px) {
    .work-hero__grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }

    .work-hero__mark {
      display: flex;
    }

    .work-standard__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(2rem, 6vw, 6rem);
      align-items: start;
    }

    .work-projects__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 2rem;
    }

    .project--featured {
      grid-column: 1 / -1;
    }

    .project__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
</style>
