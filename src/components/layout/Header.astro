---
import type { PageKey, SiteConfig } from "../../config/types";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import Logo from "../ui/Logo.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import { pageLanguage } from "../../lib/language";
import { navigationFor } from "../../lib/navigation";
import { hasSection, pageFor } from "../../lib/sections";
import { localeHref, localeHome } from "../../lib/url";

interface Props {
  site: SiteConfig;
  pageKey?: PageKey;
}

const { site, pageKey = "home" } = Astro.props;
const language = pageLanguage(site);
const ui = language.t;
const page = pageFor(site);
const navigation = navigationFor(site, pageKey);
const home = localeHome(site);

const headerAction = site.headerAction
  ? { ...site.headerAction, href: localeHref(site, site.headerAction.href) }
  : undefined;
const contact = hasSection(page, "contact") ? site.contact : undefined;
const contactHref = contact ? localeHref(site, "#contact") : undefined;
---

<a class="skip-link" href="#main">{ui.skipToContent}</a>

<header class="site-header">
  <div class="shell header-inner">
    <Logo brand={site.brand} href={home} showDescriptor={false} priority class="header-logo" />

    <nav class="desktop-nav" aria-label={ui.primaryNavigation}>
      {
        navigation.map((item) => (
          <a
            class="nav-link"
            href={item.href}
            aria-current={item.current ? "page" : undefined}
            data-nav-section={item.section ?? undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <div class="header-lang">
        <LanguageSwitch site={site} pageKey={pageKey} />
      </div>
      {
        headerAction && (
          <Button
            {...headerAction}
            class="header-cta"
          />
        )
      }
      <button
        class="menu-button"
        type="button"
        aria-label={ui.openMenu}
        aria-haspopup="dialog"
        aria-controls="site-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
</header>

<noscript>
  <nav class="noscript-nav" aria-label={ui.primaryNavigation}>
    <div class="shell noscript-nav__inner">
      {navigation.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
      {headerAction && (
        <a
          class:list={["btn", `btn--${headerAction.variant ?? "primary"}`]}
          href={headerAction.href}
        >
          {headerAction.label}
        </a>
      )}
    </div>
  </nav>
</noscript>

<dialog
  class="menu-dialog"
  id="site-menu"
  aria-label={ui.siteMenu}
  data-menu
>
  <div class="menu-shell">
    <div class="menu-header">
      <Logo brand={site.brand} href={home} showDescriptor={false} class="menu-logo" />
      <button
        class="menu-close"
        type="button"
        aria-label={ui.closeMenu}
        autofocus
        data-menu-close
      >
        <Icon name="close" size={20} />
      </button>
    </div>

    <nav class="menu-links" aria-label={ui.mobileNavigation}>
      {
        navigation.map((item, index) => (
          <a
            class="menu-link"
            href={item.href}
            aria-current={item.current ? "page" : undefined}
            data-nav-section={item.section ?? undefined}
          >
            <span class="menu-link__index" aria-hidden="true">
              {language.index(index + 1)}
            </span>
            <span>{item.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="menu-footer">
      {headerAction && (
        <Button {...headerAction} class="menu-footer__cta" />
      )}
      <div class="menu-footer__meta">
        {contactHref && <a href={contactHref}>{ui.contact}</a>}
        <LanguageSwitch site={site} pageKey={pageKey} />
      </div>
    </div>
  </div>
</dialog>

<script>
  import { initMenu } from "../../lib/client/menu";
  import { initSectionNav } from "../../lib/client/section-nav";

  initMenu();
  initSectionNav();
</script>
