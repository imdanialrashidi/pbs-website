---
import type { PageKey, SiteConfig } from "../../config/types";
import { pageLanguage } from "../../lib/language";
import { navigationFor } from "../../lib/navigation";
import { localePageHref } from "../../lib/routes";
import { localeHref, localeHome } from "../../lib/url";
import LanguageSwitch from "./LanguageSwitch.astro";
import Logo from "../ui/Logo.astro";

interface Props {
  site: SiteConfig;
  pageKey?: PageKey;
}

const { site, pageKey = "home" } = Astro.props;
const language = pageLanguage(site);
const ui = language.t;
const year = language.year();
const contactLinks = site.contactLinks ?? {};
const channels = site.contact?.channels ?? [];
const availableChannels = channels.filter((channel) => contactLinks[channel.id]?.href);

const backToTopHref = pageKey === "work" ? "#main" : localeHref(site, "#hero");
const contactHref = localeHref(site, "#contact");

const exploreLinks = [
  ...navigationFor(site, pageKey),
  {
    label: ui.work,
    href: localePageHref(site, "work"),
    current: pageKey === "work",
  },
  ...(site.contact ? [{ label: ui.contact, href: contactHref, current: false }] : []),
].filter(
  (item, index, items) => items.findIndex((candidate) => candidate.href === item.href) === index,
);
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo
          brand={site.brand}
          href={localeHome(site)}
          showDescriptor={false}
          variant="on-dark"
        />
        <p class="footer__tagline">{site.footer.tagline}</p>
        {site.footer.disclosure && <p class="footer__disclosure">{site.footer.disclosure}</p>}
      </div>

      <nav class="footer__explore" aria-label={ui.footerNavigation}>
        <p class="footer__heading">{ui.explore}</p>
        <div class="footer__links">
          {
            exploreLinks.map((item) => (
              <a href={item.href} aria-current={item.current ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </div>
      </nav>

      {
        site.contact && (
          <div class="footer__contact">
            <p class="footer__heading">{ui.contact}</p>
            {availableChannels.length > 0 ? (
              <div class="footer__channels">
                {channels.map((channel) => {
                  const resolved = contactLinks[channel.id];
                  return resolved?.href ? (
                    <a
                      class="footer__channel"
                      href={resolved.href}
                      target={resolved.external ? "_blank" : undefined}
                      rel={resolved.external ? "noopener noreferrer" : undefined}
                    >
                      <span>{channel.label}</span>
                      {resolved.display && (
                        <bdi class="footer__channel-value" dir="ltr">
                          {resolved.display}
                        </bdi>
                      )}
                      {resolved.external && <span class="sr-only">{ui.opensInNewTab}</span>}
                    </a>
                  ) : null;
                })}
              </div>
            ) : (
              <div class="footer__pending">
                <a class="footer__contact-link" href={contactHref}>
                  {ui.openChannel}
                </a>
                <p class="footer__status">{ui.contactPending}</p>
              </div>
            )}
          </div>
        )
      }
    </div>

    <div class="footer__bottom">
      <p class="footer__meta">
        <span>© {year} {site.brand.name}</span>
        <span>{ui.staticNoTracking}</span>
      </p>
      <div class="footer__bottom-actions">
        <a class="footer__top-link" href={backToTopHref}>{ui.backToTop}</a>
        <LanguageSwitch site={site} pageKey={pageKey} class="footer__lang" />
      </div>
    </div>
  </div>
</footer>
