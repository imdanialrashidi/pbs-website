---
import type { HeroScopeMap, SiteConfig } from "../../config/types";
import { pageLanguage } from "../../lib/language";

interface Props {
  site: SiteConfig;
  map: HeroScopeMap;
}

const { site, map } = Astro.props;
const language = pageLanguage(site);
---

<figure class="scope-map" aria-labelledby="scope-map-title">
  <div class="scope-map__head">
    <span id="scope-map-title" class="scope-map__title">{map.title}</span>
    <span class="scope-map__stamp">{map.stamp}</span>
  </div>

  <div class="scope-map__body">
    <p class="scope-map__input">{map.input}</p>

    <ul class="scope-map__layers">
      {
        map.layers.map((layer, index) => (
          <li class="scope-map__layer">
            <span class="scope-map__number" aria-hidden="true">
              {language.index(index + 1)}
            </span>
            <span class="scope-map__layer-copy">
              <span class="scope-map__label">{layer.label}</span>
              <strong>{layer.title}</strong>
              <span class="scope-map__detail">{layer.detail}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <p class="scope-map__output">
      <svg class="scope-map__check" viewBox="0 0 16 16" aria-hidden="true">
        <path d="m3 8.4 3 3L13 4.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {map.output}
    </p>
  </div>

  <figcaption class="scope-map__caption">{map.caption}</figcaption>
</figure>

<style>
  .scope-map {
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-top: 2px solid var(--c-accent);
    border-radius: var(--shape-media);
    background: var(--c-tint);
    box-shadow: 0 1px 2px rgb(16 24 40 / 4%);
  }

  .scope-map__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--c-line);
    padding: 0.8rem 1rem;
    background: var(--c-surface);
  }

  .scope-map__title {
    font-family: var(--type-display);
    font-size: 0.88rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .scope-map__stamp {
    color: var(--c-muted);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    white-space: nowrap;
  }

  .scope-map__body {
    padding: 0.9rem 1rem 1rem;
  }

  .scope-map__input {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--c-line);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    background: var(--c-surface);
    color: var(--c-muted);
    font-size: 0.74rem;
    font-weight: 650;
    line-height: 1.5;
  }

  .scope-map__input::before {
    width: 0.35rem;
    height: 0.35rem;
    background: var(--c-action);
    content: "";
    flex: none;
  }

  .scope-map__layers {
    position: relative;
    display: grid;
    gap: 0.4rem;
    margin-block: 0.65rem;
    padding-inline-start: 1.35rem;
  }

  .scope-map__layers::before {
    position: absolute;
    inset-block: 0.3rem;
    inset-inline-start: 0.36rem;
    width: 1px;
    background: var(--c-line);
    content: "";
  }

  .scope-map__layer {
    position: relative;
    display: grid;
    grid-template-columns: 2.15rem minmax(0, 1fr);
    gap: 0.65rem;
    align-items: center;
    border: 1px solid var(--c-line);
    border-radius: 8px;
    padding: 0.55rem 0.65rem;
    background: var(--c-surface);
  }

  .scope-map__layer::before {
    position: absolute;
    inset-inline-start: -1.05rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 0 2px var(--c-tint);
    content: "";
  }

  .scope-map__number {
    display: inline-flex;
    width: 2.15rem;
    height: 2.15rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--c-line);
    border-radius: 6px;
    background: var(--c-tint);
    color: var(--c-action);
    font-family: var(--type-body);
    font-size: 0.62rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .scope-map__layer-copy {
    display: grid;
    gap: 0.08rem;
    min-width: 0;
  }

  .scope-map__label {
    color: var(--c-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .scope-map__layer-copy strong {
    font-family: var(--type-display);
    font-size: 0.9rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.45;
  }

  .scope-map__detail {
    color: var(--c-muted);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .scope-map__output {
    display: flex;
    min-height: 2.5rem;
    align-items: center;
    gap: 0.5rem;
    border-radius: 7px;
    padding: 0.55rem 0.7rem;
    background: var(--c-action);
    color: var(--c-action-ink);
    font-size: 0.8rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .scope-map__check {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--c-accent);
    flex: none;
  }

  .scope-map__caption {
    border-top: 1px solid var(--c-line);
    padding: 0.65rem 1rem;
    background: var(--c-surface);
    color: var(--c-muted);
    font-size: 0.74rem;
    line-height: 1.65;
  }

  :lang(fa) .scope-map__title {
    font-weight: 700;
    line-height: 1.6;
  }

  :lang(fa) .scope-map__stamp,
  :lang(fa) .scope-map__label {
    letter-spacing: 0;
    text-transform: none;
  }

  :lang(fa) .scope-map__layer-copy strong {
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.6;
  }

  :lang(fa) .scope-map__detail,
  :lang(fa) .scope-map__caption {
    line-height: 1.8;
  }

  :lang(fa) .scope-map__label {
    font-size: 0.72rem;
  }

  @media (min-width: 480px) {
    .scope-map__head {
      padding: 0.85rem 1.15rem;
    }

    .scope-map__body {
      padding: 1rem 1.15rem 1.1rem;
    }

    .scope-map__caption {
      padding-inline: 1.15rem;
    }
  }
</style>
