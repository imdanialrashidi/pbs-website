---
import type { SiteConfig } from "../../config/types";
import Button from "../ui/Button.astro";
import HeadlineText from "../ui/Headline.astro";
import type { SectionSlot } from "../../lib/sections";
import { localeHref } from "../../lib/url";
import SystemMap from "./SystemMap.astro";

interface Props {
  site: SiteConfig;
  section: SectionSlot;
}

const { site, section } = Astro.props;
const { hero } = site;
const actions = hero.actions.map((action) => ({
  ...action,
  href: localeHref(site, action.href),
}));
---

<section id={section.id} class="hero" aria-labelledby={section.headingId}>
  <div class="shell hero__grid">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">{hero.eyebrow}</p>

      <h1 id={section.headingId} class="display display--xl hero__title">
        <HeadlineText headline={hero.headline} />
      </h1>

      <p class="hero__intro">{hero.intro}</p>

      <div class="hero__actions">
        {actions.map((action) => <Button {...action} />)}
      </div>
    </div>

    <div class="hero__visual">
      <SystemMap site={site} map={hero.scopeMap} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    border-bottom: 1px solid var(--c-line);
    padding-block: clamp(1.5rem, 4vw, 3.25rem) clamp(2.5rem, 6vw, 5rem);
    background: var(--c-canvas);
  }

  .hero__grid {
    display: grid;
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    min-width: 0;
  }

  .hero__eyebrow {
    margin-bottom: clamp(0.9rem, 2vw, 1.25rem);
  }

  .hero__title {
    max-width: 18ch;
  }

  :lang(fa) .hero__title {
    max-width: 19ch;
  }

  .hero__intro {
    max-width: 49ch;
    margin-top: 1.2rem;
    color: var(--c-muted);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.14rem);
    line-height: 1.85;
  }

  :lang(fa) .hero__intro {
    max-width: 52ch;
    line-height: 1.95;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .hero__visual {
    width: 100%;
    max-width: 30rem;
    min-width: 0;
    justify-self: center;
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: clamp(2rem, 5vw, 5rem);
    }

    .hero__copy {
      padding-block: 0.75rem;
    }

    .hero__visual {
      max-width: none;
      justify-self: end;
    }
  }

  @media (max-width: 959px) {
    .hero__visual {
      margin-top: 0.35rem;
    }
  }
</style>
