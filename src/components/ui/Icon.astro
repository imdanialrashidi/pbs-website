---
import {
  ArrowUpRight,
  Menu,
  MessageCircle,
  MessagesSquare,
  Phone,
  Plus,
  Send,
  X,
} from "@lucide/astro";
import type { IconName } from "../../config/types";

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  label?: string;
}

const { name, size = 18, strokeWidth = 1.5, class: className, label } = Astro.props;

const icons = {
  "arrow-up-right": ArrowUpRight,
  phone: Phone,
  close: X,
  menu: Menu,
  plus: Plus,
  "message-circle": MessageCircle,
  "messages-square": MessagesSquare,
  send: Send,
} as const;

const IconComponent = icons[name];
const directional = name === "arrow-up-right";
---

<IconComponent
  size={size}
  stroke-width={strokeWidth}
  class:list={["icon", directional && "icon--directional", className]}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  role={label ? "img" : undefined}
/>
