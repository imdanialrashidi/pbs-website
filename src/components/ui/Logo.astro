---
import type { SiteConfig } from "../../config/types";
import { base, href } from "../../lib/url";

interface Props {
  brand: SiteConfig["brand"];
  class?: string;
  href?: string;
  showDescriptor?: boolean;
  /** The header logo is above the fold; the footer copy can load lazily. */
  priority?: boolean;
  /** `on-dark` uses the owner-supplied transparent logo for the footer. */
  variant?: "default" | "on-dark";
}

const {
  brand,
  class: className,
  href: link = base,
  showDescriptor = true,
  priority = false,
  variant = "default",
} = Astro.props;
const logo = variant === "on-dark" ? brand.logoOnDark : brand.logo;
const logoAlt = logo?.alt ?? `${brand.name} | ${brand.descriptor}`;
---

<a href={link} class:list={["brand", className]}>
  {
    logo ? (
      <img
        class="brand__logo"
        src={href(logo.src)}
        alt={logoAlt}
        width={logo.width}
        height={logo.height}
        loading={priority ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={priority ? "high" : undefined}
      />
    ) : (
      <svg
        class="brand__mark"
        viewBox="0 0 32 32"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        aria-hidden="true"
      >
        {brand.mark === "tide" && (
          <>
            <path d="M3 10.5c4.2-4 8.2-4 12.4 0s8.2 4 13.6 0" />
            <path d="M3 17c4.2-4 8.2-4 12.4 0s8.2 4 13.6 0" />
            <path d="M3 23.5c4.2-4 8.2-4 12.4 0s8.2 4 13.6 0" />
          </>
        )}
        {brand.mark === "frame" && (
          <>
            <rect x="4" y="4" width="24" height="24" />
            <path d="M4 23 23 4" />
            <path d="M11 28V23h5" />
          </>
        )}
        {brand.mark === "sun" && (
          <>
            <circle cx="16" cy="16" r="5.5" />
            <path d="M16 3v4M16 25v4M3 16h4M25 16h4M7 7l3 3M22 22l3 3M25 7l-3 3M10 22l-3 3" />
          </>
        )}
      </svg>
    )
  }
  {
    (!logo || showDescriptor) && (
      <span class="brand__text">
        {!logo && <span class="brand__name">{brand.name}</span>}
        {showDescriptor && <span class="brand__descriptor">{brand.descriptor}</span>}
      </span>
    )
  }
</a>
